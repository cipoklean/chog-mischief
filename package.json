{
  "name": "chog-mischief",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "harvest": "python3 scripts/harvest-traits.py --concurrency 6",
    "harvest:owners": "node --import ./scripts/ts-resolve.mjs scripts/harvest-owners.mjs",
    "snapshot:chogs": "node scripts/build-snapshot.mjs",
    "sim:balance": "node --import ./scripts/ts-resolve.mjs scripts/sim-balance.mjs",
    "verify:chain": "node --import ./scripts/ts-resolve.mjs scripts/verify-holder.mjs",
    "verify:signin": "node scripts/e2e-signin.mjs",
    "verify:nonces": "node --import ./scripts/ts-resolve.mjs scripts/verify-nonce-supabase.mjs",
    "verify:prank": "node --import ./scripts/ts-resolve.mjs scripts/verify-prank-flow.mjs",
    "test:ui": "playwright test",
    "verify:ui": "next build && (next start -p 3104 & echo $! > .next-ui.pid) && sleep 8 && playwright test; kill $(cat .next-ui.pid) 2>/dev/null; rm -f .next-ui.pid; exit 0",
    "verify:prank:forgery": "node --import ./scripts/ts-resolve.mjs scripts/verify-prank-forgery.mjs"
  },
  "dependencies": {
    "@reown/appkit": "^1.8.24",
    "@reown/appkit-adapter-wagmi": "^1.8.24",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "^2.57.4",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
