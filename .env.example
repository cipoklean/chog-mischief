# Reown/WalletConnect project id (free plan). Public by design: it ships to the
# browser and is not a secret. WalletConnect REQUIRES it in the client bundle.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=775df7cfb6347b857efece8379841330

# --- Monad mainnet (chain 143) ---
NEXT_PUBLIC_CHOG_CONTRACT=0xc96d31f8626c6d03fae5dcd3d61e3fb9f4a73763
NEXT_PUBLIC_MONAD_RPC=https://rpc.monad.xyz
MONAD_RPC_FALLBACKS=https://rpc1.monad.xyz,https://rpc3.monad.xyz

# --- Supabase (server-only; NEVER prefix these with NEXT_PUBLIC_) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Server session signing ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Bearer token Vercel sends when it fires the daily cron. The cron endpoint
# rejects any request without it. Generate with: openssl rand -hex 32
CRON_SECRET=
